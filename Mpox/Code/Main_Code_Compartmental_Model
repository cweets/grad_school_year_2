#Implement an SIRV model instead to consider the vaccine. Parameters will be unchanged from above; except now vaccine efficacy is a consideration we have to make. 
#####################################
def sirv_model(SVIR, t, mu, nu, beta, epsilon, gamma, alpha):
# function for set of differential equations for our SIR model
    S, V, I, R = SVIR
    
    # Change in Susceptibles
    dSdt = mu * (S + I + R) - mu * S - nu * S - beta * S * I
    
    # Change in Vaccinated
    dVdt = nu * S - mu * V - (1 - epsilon) * beta * V * I
    
    # Change in Infected
    dIdt = beta * S * I - (mu + gamma + alpha) * I + (1 - epsilon) * beta * V * I
    
    # Change in Recovered
    dRdt = gamma * I - mu * R

    return [dSdt, dVdt, dIdt, dRdt]

#####################################
def compute_sirv_model(S0, V0, I0, R0, tvalues, mu, nu, beta, epsilon, gamma, alpha):
# Solve differential equations of SIR model using the scipy library and plot the results
    solution = sp_int.odeint(func=sirv_model, y0=(S0, V0, I0, R0), t=tvalues, args=(mu, nu, beta, epsilon, gamma, alpha))
    S = solution[:, 0] # S is the size of the susceptible population
    V = solution[:, 1] # V is the size of the vaccinated population
    I = solution[:, 2] # I is the size of the infected population
    R = solution[:, 3] # R is the size of the recovered population

    #####################################
    # Plot the population sizes for susceptibles, infecteds and recovereds
    plt.plot(tvalues, S, 'b', label='susceptibles')
    plt.plot(tvalues, V, 'purple', label='vaccinated')
    plt.plot(tvalues, I, 'r', label='infecteds')
    plt.plot(tvalues, R, 'g', label='recovered')
    plt.legend(loc='best')
    plt.xlabel('time')
    plt.ylabel('population size')
    plt.grid()

    return S, V, I, R

