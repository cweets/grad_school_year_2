#First present the SIR model without vaccination
#####################################
def sir_model(SIR, t, mu, beta, gamma, alpha):
# function for set of differential equations for our SIR model
    S, I, R = SIR
    # How Susceptibles change over time
    dSdt = mu * (S+I+R) -mu * S -beta * S * I

    # How Infecteds change over time
    dIdt = -mu* I + beta * S * I - gamma * I - alpha * I

    # How Recovereds change over time
    dRdt = -mu * R + gamma * I 

    return [dSdt, dIdt, dRdt]

#####################################
def compute_sir_model(S0, I0, R0, tvalues, mu, beta, gamma, alpha):
# Solve differential equations of SIR model using the scipy library and plot the results
    solution = sp_int.odeint(func=sir_model, y0=(S0, I0, R0), t=tvalues, args=(mu, beta, gamma, alpha))
    S = solution[:, 0] # S is the size of the susceptible population
    I = solution[:, 1] # I is the size of the infected population
    R = solution[:, 2] # R is the size of the recovered population

    #####################################
    # Plot the population sizes for susceptibles, infecteds and recovereds
    plt.plot(tvalues, S, 'b', label='susceptibles')
    plt.plot(tvalues, I, 'r', label='infecteds')
    plt.plot(tvalues, R, 'g', label='recovered')
    plt.legend(loc='best')
    plt.xlabel('time')
    plt.ylabel('population size')
    plt.grid()

    return S, I, R
