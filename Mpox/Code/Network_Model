def shut_all_bars(network, r): #function with inputs of network name, restriction (r) level, which is the reduction of contacts between individuals and professional sex workers as a result of bar closings - we assume here that 100% of bars that people in the network frequent are closed
    
    net_copy = network.copy() #copies the network
    
    hubs = [node for (node, val) in network.degree() if val > 10] #makes a list of the nodes in the copied network
   
    for hub in hubs: 
        neighbors = list(nx.neighbors(net_copy, hub)) #all of the neighbors of the hub
        edges_removed = round(len(neighbors) * r) #calculates number of edges to remove if some proportion (r) of edges are removed from a hub 
        remove_from = nprnd.choice(neighbors, size = edges_removed, replace = False) #chooses which edges get removed from the hubs
        net_copy.remove_edges_from([(hub, neighbor) for neighbor in remove_from]) #removes the selected edges from hubs
        
    return(net_copy)
