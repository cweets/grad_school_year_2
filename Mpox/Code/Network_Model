def vaccinate_psw(network, v): #function with inputs of network name and v = vaccine efficacy 
    
    net_copy = network.copy() #copies the network
    
    hubs = [node for (node, val) in network.degree() if val > 10] #makes a list of the hubs in the copied network, which are defined as nodes with degree greater than 10
    
    full_vaxxed_hubs = round(len(hubs) * v) #simulates a vaccine efficacy less than 100% by calculating some percentage of hubs to be efficaciously vaccinated
    
    vaxxed = nprnd.choice(hubs, full_vaxxed_hubs , replace=False) #chooses the hubs to be vaccinated efficaciously based upon the calculated percentage 
   
    vaxxed_hubs = net_copy.remove_nodes_from(vaxxed) #removes the selected hubs from the network
        
    return(net_copy)

