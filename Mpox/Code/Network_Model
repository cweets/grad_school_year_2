def vaccinate_randos(network, people, v): #function with inputs of network name, p = number of people vaccinated and v = vaccine efficacy 
    
    net_copy = network.copy() #copies the network
    
    lucky_randos = nprnd.choice(list(net_copy.nodes), people, replace = False) #Selects 50 random nodes to get the vaccine from all of the possible nodes in the network
    
    full_vaxxed_randos = round(len(lucky_randos) * v) #simulates a vaccine efficacy less than 100% by calculating some percentage of random nodes to be efficaciously vaccinated
    
    vaxxed = nprnd.choice(lucky_randos, full_vaxxed_randos , replace=False) #chooses the nodes to be vaccinated efficaciously based upon the calculated percentage 
   
    vaxxed_randos = net_copy.remove_nodes_from(vaxxed) #removes the selected actually efficiaciously vaccinated nodes from the network
    return(net_copy)
